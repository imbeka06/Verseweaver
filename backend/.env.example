PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# Supabase Postgres (Settings -> Database -> Connection string, session pooler)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase auth verification (Settings -> API -> JWT Settings)
# Use AUTH_JWT_SECRET for the default HS256 signing, or AUTH_JWKS_URL for RS256.
AUTH_JWT_SECRET=
AUTH_JWKS_URL=
AUTH_ISSUER=https://<project-ref>.supabase.co

# Redis (docker compose up -d redis, or Upstash)
REDIS_URL=redis://localhost:6379

# Set true in production so unauthenticated requests are rejected.
STRICT_AUTH=false
