# Copy this file to `.env` and fill in your Supabase project values.
# Supabase Dashboard -> Settings -> API
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-public-key>

# Backend API base URL (defaults to local dev)
VITE_API_BASE_URL=http://localhost:4000/api

# Optional: realtime socket endpoint (defaults to the API host, sans /api)
# VITE_SOCKET_URL=ws://localhost:4000
